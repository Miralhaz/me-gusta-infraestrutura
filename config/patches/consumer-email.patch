+package school.sptech.consumer;
+
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.mail.SimpleMailMessage;
+import org.springframework.mail.javamail.JavaMailSender;
+import software.amazon.awssdk.services.sesv2.SesV2Client;
+import software.amazon.awssdk.services.sesv2.model.SendEmailRequest;
+import software.amazon.awssdk.services.sesv2.model.SendEmailResponse;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+class EmailServiceTest {
+
+    @Test
+    void enviaPorSesComRemetenteEDestinatarioCorretos() {
+        SesV2Client ses = mock(SesV2Client.class);
+        when(ses.sendEmail(any(SendEmailRequest.class)))
+                .thenReturn(SendEmailResponse.builder().messageId("id-1").build());
+        var service = new EmailService("ses", "alertas@megusta.com", "", null, ses);
+
+        assertEquals("destino@exemplo.com", service.enviar("destino@exemplo.com", "resumo"));
+
+        var captor = ArgumentCaptor.forClass(SendEmailRequest.class);
+        verify(ses).sendEmail(captor.capture());
+        SendEmailRequest request = captor.getValue();
+        assertEquals("alertas@megusta.com", request.fromEmailAddress());
+        assertEquals(List.of("destino@exemplo.com"), request.destination().toAddresses());
+        assertEquals("MeGusta - alerta de estoque", request.content().simple().subject().data());
+        assertEquals("resumo", request.content().simple().body().text().data());
+    }
+
+    @Test
+    void smtpUsaOverrideDeTesteNoLugarDoDestinatarioDaMensagem() {
+        JavaMailSender mail = mock(JavaMailSender.class);
+        var service = new EmailService("smtp", "from@exemplo.com",
+                "henry.silva@sptech.school", mail, null);
+
+        assertEquals("henry.silva@sptech.school", service.enviar("outro@exemplo.com", "resumo"));
+
+        var captor = ArgumentCaptor.forClass(SimpleMailMessage.class);
+        verify(mail).send(captor.capture());
+        assertArrayEquals(new String[]{"henry.silva@sptech.school"}, captor.getValue().getTo());
+        assertEquals("from@exemplo.com", captor.getValue().getFrom());
+        assertEquals("MeGusta - alerta de estoque", captor.getValue().getSubject());
+        assertEquals("resumo", captor.getValue().getText());
+    }
+
+    @Test
+    void rejeitaDestinatarioInvalido() {
+        SesV2Client ses = mock(SesV2Client.class);
+        var service = new EmailService("ses", "alertas@megusta.com", "", null, ses);
+        assertThrows(IllegalArgumentException.class, () -> service.enviar("sem-arroba", "resumo"));
+    }
+
+    @Test
+    void rejeitaRemetenteVazio() {
+        assertThrows(IllegalArgumentException.class,
+                () -> new EmailService("ses", "", "", null, mock(SesV2Client.class)));
+    }
+
+    @Test
+    void rejeitaTransporteDesconhecido() {
+        assertThrows(IllegalArgumentException.class,
+                () -> new EmailService("fax", "alertas@megusta.com", "",
+                        (JavaMailSender) null, (SesV2Client) null));
+    }
+}
