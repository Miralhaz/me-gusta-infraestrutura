+    @Autowired
+    public EmailService(
+            @Value("${megusta.email.transport:smtp}") String transport,
+            @Value("${megusta.email.from:}") String from,
+            @Value("${megusta.email.override-to:}") String overrideTo,
+            @Value("${megusta.email.ses-region:us-east-1}") String sesRegion,
+            ObjectProvider<JavaMailSender> mailSenderProvider) {
+        this(
+                transport,
+                from,
+                overrideTo,
+                mailSenderProvider.getIfAvailable(),
+                "ses".equalsIgnoreCase(trim(transport))
+                        ? SesV2Client.builder().region(Region.of(regiao(sesRegion))).build()
+                        : null
+        );
+    }
+
+    // Visivel para os testes: permite injetar JavaMailSender/SesV2Client sem rede.
+    EmailService(String transport, String from, String overrideTo,
+                 JavaMailSender mailSender, SesV2Client ses) {
+        this.transport = trim(transport).toLowerCase();
+        this.from = trim(from);
+        this.overrideTo = trim(overrideTo);
+        this.mailSender = mailSender;
+        this.ses = ses;
+
+        if (!"ses".equals(this.transport) && !"smtp".equals(this.transport)) {
+            throw new IllegalArgumentException(
+                    "MAIL_TRANSPORT invalido: " + this.transport + " (use ses ou smtp)");
+        }
+        if (!EMAIL.matcher(this.from).matches()) {
+            throw new IllegalArgumentException(
+                    "Configure o remetente (SES_FROM ou SMTP_FROM) com um e-mail valido: " + this.from);
+        }
+        if ("smtp".equals(this.transport) && this.mailSender == null) {
+            throw new IllegalArgumentException(
+                    "MAIL_TRANSPORT=smtp exige SMTP_HOST configurado (spring.mail.host)");
+        }
+        if ("ses".equals(this.transport) && this.ses == null) {
+            throw new IllegalArgumentException("MAIL_TRANSPORT=ses nao conseguiu criar o cliente SES");
+        }
+    }
+
+    /**
+     * Envia o resumo para o destinatario da mensagem ou para o override de teste.
+     *
+     * @return o destinatario efetivamente usado
+     */
+    public String enviar(String destinatario, String resumo) {
+        String to = destinatarioEfetivo(destinatario);
+        if (resumo == null || resumo.isBlank()) {
+            throw new IllegalArgumentException("Resumo vazio");
+        }
+
+        if ("ses".equals(transport)) {
+            SendEmailResponse response = ses.sendEmail(SendEmailRequest.builder()
+                    .fromEmailAddress(from)
+                    .destination(Destination.builder().toAddresses(to).build())
+                    .content(EmailContent.builder()
+                            .simple(Message.builder()
+                                    .subject(Content.builder().data(ASSUNTO).charset("UTF-8").build())
+                                    .body(Body.builder()
+                                            .text(Content.builder().data(resumo).charset("UTF-8").build())
+                                            .build())
+                                    .build())
+                            .build())
+                    .build());
+            log.debug("SES aceitou o e-mail. messageId={}", response.messageId());
+        } else {
+            SimpleMailMessage message = new SimpleMailMessage();
+            message.setFrom(from);
+            message.setTo(to);
+            message.setSubject(ASSUNTO);
+            message.setText(resumo);
+            mailSender.send(message);
+        }
+        return to;
+    }
+
+    /**
+     * Aplica o override de teste (ALERTA_EMAIL_TO) e valida o destinatario.
+     * Em producao o override fica vazio e vale o e-mail da mensagem.
+     */
+    public String destinatarioEfetivo(String destinatario) {
+        String to = overrideTo.isBlank() ? trim(destinatario) : overrideTo;
+        if (!EMAIL.matcher(to).matches()) {
+            throw new IllegalArgumentException("E-mail destinatario invalido: " + to);
+        }
+        return to;
+    }
+
+    private static String regiao(String value) {
+        String region = trim(value);
+        return region.isEmpty() ? "us-east-1" : region;
+    }
+
+    private static String trim(String value) {
+        return value == null ? "" : value.trim();
+    }
+}
