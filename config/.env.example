# =============================================================================
# MeGusta - variaveis do consumer de alertas por E-MAIL
# =============================================================================
# Copie este arquivo para config/.env e preencha os valores:
#   cp .env.example .env
#   chmod 600 .env
#
# O config/.env NAO deve ser versionado (ja esta no .gitignore).
# O deploy-swarm.sh carrega e exporta esse arquivo antes do stack deploy.
#
# Se a senha tiver caracteres especiais ($, #, espaco), use aspas simples:
#   SMTP_PASSWORD='abcd efgh ijkl mnop'
# =============================================================================

# --- Transporte de e-mail ----------------------------------------------------
# smtp = SMTP generico (Gmail, Microsoft 365 ou SES SMTP). E o caminho que
#        funciona no AWS Academy, cuja role bloqueia o gerenciamento do SES.
# ses  = AWS SES API. So funciona em uma conta cuja role permita
#        ses:CreateEmailIdentity/GetEmailIdentity/SendEmail. No sandbox do SES,
#        remetente e destinatarios de teste precisam ser verificados.
MAIL_TRANSPORT=smtp

# --- SMTP generico (somente quando MAIL_TRANSPORT=smtp) ----------------------
# Gmail:           smtp.gmail.com          porta 587  (exige "Senha de app")
# Microsoft 365:   smtp.office365.com      porta 587  (SMTP AUTH habilitado)
# Amazon SES SMTP: email-smtp.<regiao>.amazonaws.com  porta 587
#
# Gmail: ative a verificacao em duas etapas e gere uma "Senha de app" em
# https://myaccount.google.com/apppasswords. A senha normal NAO funciona.
# Preencha SMTP_USERNAME com o endereco completo da conta que envia e
# SMTP_FROM com o mesmo endereco (ou um alias autorizado).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Amazon SES (somente quando MAIL_TRANSPORT=ses) --------------------------
# No AWS Academy atual o SES esta bloqueado; deixe descomentado apenas se for
# usar uma conta com permissao. O Terraform tambem precisa de
# enable_ses_email_identity = true.
# SES_REGION=us-east-1
# SES_FROM=henry.silva@sptech.school

# true apenas para porta 465 (SSL direto). Na 587 mantenha false.
SMTP_SSL=false

# --- Destinatario de teste (opcional) ----------------------------------------
# Quando preenchido, TODO alerta vai para este e-mail, ignorando o campo
# "email" da mensagem (que no fluxo normal vem do ultimo usuario cadastrado).
# Use para testar sem mexer no banco. Deixe VAZIO em producao.
ALERTA_EMAIL_TO=henry.silva@sptech.school

# --- Remetente (opcional) ----------------------------------------------------
# NAO precisa preencher: o deploy-swarm.sh resolve o remetente como
# MEGUSTA_EMAIL_FROM > SES_FROM > SMTP_FROM (basta SMTP_FROM no modo smtp).
# Defina apenas se quiser um remetente diferente do SMTP_FROM.
# MEGUSTA_EMAIL_FROM=alertas@seudominio.com
